# Whitelist: ignore everything, then allow only our own source and docs.
# Never add game files, decompiled code or Ghidra databases here.
*
!*/
!.gitignore
!AGENTS.md
!README.md
!MODLOG.md
!STATUS.md
!Cargo.toml
!Cargo.lock
!.cargo/
!.cargo/config.toml
!.mcp.json
!.claude/
!.claude/settings.json
!*.rs
!*.md
!scripts/
!scripts/cloud_setup.sh
!scripts/merge_guard.sh
!scripts/discord_bridge.py
!scripts/protected.txt
!scripts/check.sh
!scripts/sync_issues.py
!scripts/oracle_capture.py
!scripts/oracle_capture_lib.py
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!oracle/**

# Always ignored, even though they match the allow rules above
reference/
target/
target-*/
logs/
extracted/
.claude/worktrees/
.claude/settings.local.json
